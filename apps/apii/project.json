{
  "name": "apii",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/apii/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nest build apii"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --max-old-space-size=4096 dist/apps/apii/apps/apii/src/main --watch"
      }
    },
    "migration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn mikro-orm migration:create --config apps/apii/src/mikro-orm.config.ts"
      }
    },
    "migrate:up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn mikro-orm migration:up --config apps/apii/src/mikro-orm.config.ts"
      }
    },
    "goal-status:update": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/apii && TS_NODE_PROJECT=tsconfig.app.json yarn ts-node -r tsconfig-paths/register src/scripts/update-goal-statuses.ts"
      }
    },
    "demo-data:seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/apii && TS_NODE_PROJECT=tsconfig.app.json yarn ts-node -r tsconfig-paths/register src/scripts/seed-demo-data.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/apii/tsconfig.app.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint ./apps/apii"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --selectProjects apii"
      }
    }
  }
}
