{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "esnext",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "types": [
      "electron",
      "node",
      "vite/client"
    ],
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noImplicitThis": false,
    "noErrorTruncation": true,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*",
    "forge.config.ts",
    "forge.env.d.ts",
    "vite.*.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".vite",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
