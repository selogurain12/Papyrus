{
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["typecheck", "lint"],
        "parallel": 5
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/*/"]
  },
  "targetDefaults": {
    "lint": {
      "inputs": ["default"]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint"
      }
    }
  ],
  "analytics": false
}
